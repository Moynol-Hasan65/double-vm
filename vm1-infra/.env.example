# VM1 (infra) — MySQL + MinIO. deploy.sh fills every value below on first run.

# Private IP of this VM that VM2 connects to. MySQL (3306) and MinIO (9000)
# are published on this address only.
VM1_PRIVATE_IP=__VM1_PRIVATE_IP__

# MySQL
MYSQL_ROOT_PASSWORD=replace_with_a_password
MYSQL_DATABASE=cyberwise_user
MYSQL_USER=cyberwise
MYSQL_PASSWORD=replace_with_a_password

# MinIO — deploy.sh provisions MINIO_ACCESS_KEY/MINIO_SECRET_KEY itself.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=replace_with_a_password
MINIO_ACCESS_KEY=your_access_key
MINIO_SECRET_KEY=your_secret_key
